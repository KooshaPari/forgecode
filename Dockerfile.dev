# Dockerfile.dev — Forgecode development environment
# Python base image with Rust 1.97 toolchain, dev tools, and linters.
# Usage: docker compose -f docker-compose.dev.yml up --build

FROM python:3.12-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579 AS base

# ── System dependencies ───────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    libffi-dev \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Rust toolchain (1.97, matching rust-toolchain.toml) ──────
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    --default-toolchain 1.97 \
    --profile default \
    --component rustfmt,clippy \
    -y

# ── Cargo dev tools ──────────────────────────────────────────
RUN cargo install cargo-deny cargo-nextest cargo-watch

# ── Node.js (for benchmarks/evals package.json) ─────────────
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Python dev dependencies ──────────────────────────────────
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        pytest pytest-cov pytest-xdist \
        ruff mypy \
        pip-audit build \
        pyyaml requests

WORKDIR /workspace

# ── Pre-download dependencies when possible (layer caching) ──
# Copy manifests first for better layer caching
COPY Cargo.toml Cargo.lock rust-toolchain.toml clippy.toml ./
COPY pyproject.toml pytest.ini package.json ./

# Pre-fetch Rust deps (will be invalidated on change)
RUN mkdir -p crates/forge_main/src && echo 'fn main() {}' > crates/forge_main/src/main.rs \
    && cargo fetch 2>/dev/null || true \
    && rm -rf crates/forge_main/src

# Pre-fetch Python deps
RUN pip install --no-cache-dir -e ".[dev]" 2>/dev/null || true

# Pre-fetch Node deps
RUN npm install 2>/dev/null || true

# ── Default command: build + test watch ──────────────────────
CMD ["bash"]
