[Unit]
Description=OpenTelemetry Collector for Forgecode
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/forgecode/deploy
ExecStart=/opt/forgecode/deploy/otel-collector.sh up
ExecStop=/opt/forgecode/deploy/otel-collector.sh down
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
