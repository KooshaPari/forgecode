# forgecode OTel Collector - Environment Configuration
# Copy to .env and fill in the values for your environment.

# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
OTEL_COLLECTOR_VERSION=0.110.0
JAEGER_VERSION=1.61.0
PROMETHEUS_VERSION=v2.53.0
GRAFANA_VERSION=11.1.0

# ──────────────────────────────────────────────
# Ports (Host-to-Container mapping)
# ──────────────────────────────────────────────
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# Change these in production! Use a secrets manager in real deployments.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# ──────────────────────────────────────────────
# Collector Memory Limits
# ──────────────────────────────────────────────
OTEL_MEMORY_LIMIT_MIB=1024
OTEL_MEMORY_SPIKE_LIMIT_MIB=256
