{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ForgeCode Performance Dashboard Configuration",
  "description": "Defines panels, alert thresholds, refresh intervals, data sources, and multi-region settings for the performance dashboard.",
  "version": "1.0.0",
  "dashboard": {
    "title": "ForgeCode Observability Dashboard",
    "description": "Real-time performance, latency, throughput, errors, and saturation monitoring.",
    "refresh_interval_seconds": 30,
    "time_range": {
      "default": "1h",
      "options": ["5m", "15m", "1h", "6h", "24h", "7d", "30d"]
    }
  },
  "panels": {
    "latency": {
      "title": "Request Latency",
      "description": "End-to-end request latency distributions and percentiles.",
      "type": "timeseries",
      "position": { "row": 0, "col": 0, "width": 12, "height": 8 },
      "metrics": [
        {
          "name": "forgecode.latency.ms",
          "aggregation": "histogram",
          "percentiles": [50, 95, 99, 99.9],
          "unit": "ms",
          "legend": "{{operation}} - p{{percentile}}"
        }
      ],
      "visual": {
        "fillOpacity": 15,
        "lineWidth": 2,
        "gradientMode": "opacity"
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 200 },
          { "color": "orange", "value": 500 },
          { "color": "red", "value": 1000 }
        ]
      }
    },
    "throughput": {
      "title": "Request Throughput",
      "description": "Requests per second by operation and status.",
      "type": "timeseries",
      "position": { "row": 0, "col": 12, "width": 12, "height": 8 },
      "metrics": [
        {
          "name": "forgecode.requests.total",
          "aggregation": "rate",
          "unit": "req/s",
          "groupBy": ["operation", "status"],
          "legend": "{{operation}} ({{status}})"
        }
      ],
      "visual": {
        "fillOpacity": 10,
        "lineWidth": 2,
        "gradientMode": "opacity",
        "stacking": { "mode": "normal" }
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 10 },
          { "color": "green", "value": 50 }
        ]
      }
    },
    "errors": {
      "title": "Error Rate",
      "description": "Error count and rate by operation and error type.",
      "type": "timeseries",
      "position": { "row": 8, "col": 0, "width": 12, "height": 8 },
      "metrics": [
        {
          "name": "forgecode.errors.total",
          "aggregation": "rate",
          "unit": "errors/s",
          "groupBy": ["operation", "error_type"],
          "legend": "{{operation}}: {{error_type}}"
        }
      ],
      "visual": {
        "fillOpacity": 20,
        "lineWidth": 2,
        "color": { "mode": "palette-classic" }
      },
      "thresholds": {
        "mode": "percentage",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "orange", "value": 3 },
          { "color": "red", "value": 5 }
        ]
      }
    },
    "saturation": {
      "title": "Resource Saturation",
      "description": "Active connections and resource utilization metrics.",
      "type": "gauge",
      "position": { "row": 8, "col": 12, "width": 12, "height": 8 },
      "metrics": [
        {
          "name": "forgecode.connections.active",
          "aggregation": "last",
          "unit": "connections",
          "legend": "Active Connections"
        },
        {
          "name": "forgecode.health",
          "aggregation": "last",
          "unit": "status",
          "legend": "Service Health"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 80 },
          { "color": "orange", "value": 90 },
          { "color": "red", "value": 95 }
        ]
      }
    }
  },
  "alert_thresholds": {
    "error_rate_pct": 5.0,
    "p99_latency_ms": 1000,
    "p95_latency_ms": 500,
    "cpu_saturation_pct": 80,
    "memory_saturation_pct": 85,
    "connection_saturation_pct": 90,
    "slo_target_pct": 99.9,
    "min_throughput_rps": 10
  },
  "alert_channels": [
    {
      "type": "slack",
      "enabled": true,
      "channel": "#forgecode-alerts",
      "severity_filter": ["warning", "critical"]
    },
    {
      "type": "pagerduty",
      "enabled": true,
      "severity_filter": ["critical"],
      "escalation_policy": "forgecode-oncall"
    },
    {
      "type": "email",
      "enabled": true,
      "recipients": ["platform-team@forgecode.dev"],
      "severity_filter": ["critical"]
    }
  ],
  "data_sources": {
    "primary": {
      "type": "prometheus",
      "url": "http://prometheus:9090",
      "scrape_interval_seconds": 15,
      "query_timeout_seconds": 30
    },
    "secondary": {
      "type": "otlp",
      "protocol": "grpc",
      "endpoint": "http://otel-collector:4317",
      "fallback": {
        "type": "otlp",
        "protocol": "http/protobuf",
        "endpoint": "http://otel-collector:4318"
      }
    },
    "logs": {
      "type": "loki",
      "url": "http://loki:3100",
      "label_matchers": {
        "service": "forgecode",
        "environment": "{{environment}}"
      }
    },
    "traces": {
      "type": "tempo",
      "url": "http://tempo:3200",
      "search_limit": 1000
    }
  },
  "multi_region": {
    "enabled": true,
    "regions": [
      {
        "id": "us-east-1",
        "name": "US East (Virginia)",
        "priority": 1,
        "dashboard_url": "https://grafana.us-east-1.forgecode.dev/d/forgecode",
        "prometheus_url": "http://prometheus.us-east-1.internal:9090",
        "otel_endpoint": "http://otel-collector.us-east-1.internal:4317"
      },
      {
        "id": "eu-west-1",
        "name": "EU West (Ireland)",
        "priority": 2,
        "dashboard_url": "https://grafana.eu-west-1.forgecode.dev/d/forgecode",
        "prometheus_url": "http://prometheus.eu-west-1.internal:9090",
        "otel_endpoint": "http://otel-collector.eu-west-1.internal:4317"
      },
      {
        "id": "ap-southeast-1",
        "name": "Asia Pacific (Singapore)",
        "priority": 3,
        "dashboard_url": "https://grafana.ap-southeast-1.forgecode.dev/d/forgecode",
        "prometheus_url": "http://prometheus.ap-southeast-1.internal:9090",
        "otel_endpoint": "http://otel-collector.ap-southeast-1.internal:4317"
      }
    ],
    "aggregation": {
      "mode": "regional",
      "cross_region_comparison": true,
      "global_overlay": true
    },
    "failover": {
      "strategy": "priority-based",
      "health_check_interval_seconds": 10,
      "auto_failover": true
    }
  },
  "annotations": {
    "deployments": {
      "enabled": true,
      "source": "github",
      "match_labels": ["deploy"]
    },
    "incidents": {
      "enabled": true,
      "source": "pagerduty",
      "severity_colors": {
        "critical": "red",
        "warning": "orange",
        "info": "yellow"
      }
    },
    "chaos_experiments": {
      "enabled": true,
      "source": "manual",
      "default_duration_minutes": 30
    }
  },
  "variables": {
    "environment": {
      "type": "custom",
      "options": ["production", "staging", "development"],
      "default": "production",
      "label": "Environment"
    },
    "region": {
      "type": "query",
      "query": "label_values(forgecode_requests_total, region)",
      "default": "all",
      "label": "Region",
      "multi": true
    },
    "operation": {
      "type": "query",
      "query": "label_values(forgecode_requests_total, operation)",
      "default": "all",
      "label": "Operation",
      "multi": true
    }
  }
}
